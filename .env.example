# Copy this file to .env for local development. Never commit .env.
# These are placeholders for the local docker-compose database only.

# Local Postgres container (read by docker-compose.yml)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=cookbook
POSTGRES_PORT=5432

# App configuration (the same variables are set in the Railway dashboard)
DATABASE_URL=postgresql://user:password@localhost:5432/cookbook
PORT=3000
UPLOAD_DIR=./data/uploads
