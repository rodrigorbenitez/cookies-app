{
  "name": "cookies-app",
  "private": true,
  "version": "1.0.0",
  "description": "Personal cookbook and baking PWA",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "prepare": "husky || true",
    "dev": "npm run dev -w server & npm run dev -w client",
    "build": "npm run build -w client && npm run build -w server",
    "start": "npm run start -w server",
    "seed": "npm run seed -w server",
    "test": "npm run test -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "db:generate": "npm run db:generate -w server",
    "secrets:scan": "gitleaks git --redact --verbose ."
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
