# Block commits that contain secrets. Requires gitleaks: https://github.com/gitleaks/gitleaks#installing
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks is not installed. Install it to commit: https://github.com/gitleaks/gitleaks#installing" >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --verbose
